{
  "version": 1,
  "_comment": "비밀키 탐지 패턴. confirmed=확실(리포트에 '확정'), suspect=정황상(리포트에 '의심'). ★값은 읽지 않고 '있다'까지만. 자동삭제 절대 안 함. masked는 safe_prefix(공개 접두사 상수)로만 조립 — 파일 내용에서 잘라오지 않음. (PRD 07_SECURITY §2.3, T1/T2)",
  "confirmed": [
    { "id": "anthropic_key", "label": "Anthropic API 키", "safe_prefix": "sk-ant-", "regex": "sk-ant-[A-Za-z0-9_\\-]{20,}" },
    { "id": "openai_key", "label": "OpenAI API 키", "safe_prefix": "sk-", "regex": "sk-[A-Za-z0-9]{32,}" },
    { "id": "aws_access_key", "label": "AWS 액세스 키", "safe_prefix": "AKIA", "regex": "AKIA[0-9A-Z]{16}" },
    { "id": "github_token", "label": "GitHub 토큰", "safe_prefix": "gh*_", "regex": "gh[pousr]_[A-Za-z0-9]{36,}" },
    { "id": "google_api_key", "label": "Google API 키", "safe_prefix": "AIza", "regex": "AIza[0-9A-Za-z_\\-]{35}" },
    { "id": "slack_token", "label": "Slack 토큰", "safe_prefix": "xox", "regex": "xox[baprs]-[A-Za-z0-9-]{10,}" },
    { "id": "private_key_pem", "label": "개인 키(PEM 블록)", "safe_prefix": "-----BEGIN PRIVATE KEY", "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----" }
  ],
  "suspect": [
    { "id": "generic_assignment", "label": "비밀번호/키 의심 대입", "regex": "(password|passwd|secret|api[_-]?key|token|private[_-]?key)\\s*[:=]\\s*[\"']?[^\\s\"']{8,}", "flags": "i" }
  ],
  "allowlist": {
    "_comment": "confirmed/suspect 패턴이 매칭된 '같은 줄'에 이 중 하나라도 매칭되면 오탐(실제 비밀키 아님)으로 보고 finding에서 제외한다. 전부 실사용 문서에서 흔히 쓰는 '진짜 값이 아님' 표시 관례(예: AWS 공식 문서의 AKIA...EXAMPLE)만 담는다 — 실제 키가 우연히 이 마커를 포함할 확률은 사실상 0(2026-08-31 C-G2 실측: sk-ant-xxxx.../ghp_XXXX.../AKIA...EXAMPLE 3종이 정상 오탐되던 것을 확인 후 추가).",
    "patterns": [
      { "id": "example_marker", "label": "EXAMPLE 표기(AWS 등 공식 문서 관례)", "regex": "EXAMPLE", "flags": "i" },
      { "id": "your_x_here_marker", "label": "YOUR_..._HERE 스타일 플레이스홀더", "regex": "YOUR[-_][A-Za-z0-9_-]*[-_]HERE", "flags": "i" },
      { "id": "repeated_placeholder_char", "label": "x/X 6개 이상 반복(플레이스홀더 관례)", "regex": "[xX]{6,}" },
      { "id": "redacted_marker", "label": "REDACTED 표기(이 도구 자신의 마스킹 출력 포함)", "regex": "REDACTED", "flags": "i" }
    ]
  }
}
